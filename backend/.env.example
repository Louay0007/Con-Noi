# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Comma-separated list of allowed browser origins (no trailing slash).
FRONTEND_URL=https://your-domain.example

# ── Database ──────────────────────────────────────────────────────
# Atlas or self-hosted replica set. Replica set is required only if you
# later enable transactions; the app currently runs on a standalone node.
MONGO_URI=mongodb://localhost:27017/worker_platform
MONGO_REPLICA_SET=

# ── Cookies ───────────────────────────────────────────────────────
# Auth cookies are HttpOnly and SameSite=Lax. Leave empty to derive from
# NODE_ENV (Secure in production). Set COOKIE_SECURE=false only while the app
# is served over plain http, e.g. http://<ip>:8080 before TLS is in place —
# browsers silently drop Secure cookies over http.
COOKIE_SECURE=

# ── Auth ──────────────────────────────────────────────────────────
# REQUIRED: at least 32 characters each. The app refuses to boot otherwise.
# Generate with: node scripts/gen-secrets.js
JWT_ACCESS_SECRET=replace_with_32_plus_random_characters_access
JWT_REFRESH_SECRET=replace_with_32_plus_random_characters_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── File storage ──────────────────────────────────────────────────
# disk = local folder (simple VPS). s3 = S3-compatible bucket (recommended
# for multi-instance or platforms with ephemeral disks).
STORAGE_DRIVER=disk
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=10

S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ── Transactional email ───────────────────────────────────────────
# Leave MAIL_HOST empty to write emails to the container log instead of
# sending them (fine for demos; password reset still works via the log).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Con noi <no-reply@your-domain.example>

# Minutes a password-reset link stays valid.
RESET_TOKEN_TTL_MINUTES=60

# ── Abuse protection ──────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Seed admin (used once by `npm run seed`) ──────────────────────
SEED_ADMIN_EMAIL=admin@your-domain.example
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
